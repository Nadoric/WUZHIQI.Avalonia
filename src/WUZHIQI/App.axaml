<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WUZHIQI.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- 同时内置常规、粗体中文字体，避免不同手机的系统字体回退缺字。 -->
        <FontFamily x:Key="ChineseFont">avares://WUZHIQI/Assets/Fonts#Noto Sans CJK SC</FontFamily>
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://WUZHIQI/Assets/Fonts#Noto Sans CJK SC</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector=":is(TemplatedControl)">
            <Setter Property="FontFamily" Value="{StaticResource ChineseFont}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ChineseFont}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.gameAction">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Application.Styles>
</Application>
