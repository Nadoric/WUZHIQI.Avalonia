<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android37.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.wuziqi.gomoku</ApplicationId>
    <ApplicationTitle>五子棋</ApplicationTitle>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.3</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WUZIQI/WUZIQI.csproj"/>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)"/>
    <PackageReference Include="SkiaSharp" Version="3.119.4"/>
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.4"/>
  </ItemGroup>
</Project>
